# ── Root .gitignore (frontend/ and backend/ have their own as well) ──────────

# Dependencies / build caches that may leak into the repo root
/node_modules
# orphaned root lockfile — the real one lives in frontend/
/package-lock.json
.vite/
dist/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# Stray OpenSSL seed file
**/.rnd

# ── Private / beneficiary data — NEVER commit to a public template repo ──────
# Source research brief contains personal information about the beneficiary.
Adas_research.docx
*.research.docx
