---
import type { SiteContent } from '../../lib/types'
import type { Translator } from '../../i18n/ui'
import { zl } from '../../i18n/config'
import DonateTrigger from '../islands/DonateTrigger.vue'

interface Props { site: SiteContent; t: Translator }
const { site, t } = Astro.props
const { budget } = site
---

<section class="sec" id="budget">
  <p class="kicker">{t('budget.kicker')}</p>
  <h2 class="h2">{t('budget.title')}</h2>
  <p class="sub">{t('budget.subtitle')}</p>

  <div class="totals">
    <div><span class="big">{zl(budget.total)}</span><span class="cap">{t('common.monthlyCost')}</span></div>
    <div class="gap">{t('common.gapMissing', { amount: zl(budget.gap) })}</div>
  </div>

  <ul class="items">
    {budget.items.map((it) => (
      <li class="item">
        <div class="item-main">
          <p class="item-name">{it.name}</p>
          <p class="item-note">{it.note}</p>
          <p class="item-freq">{it.freq}</p>
        </div>
        <div class="item-right">
          <span class="item-cost">{zl(it.cost)}</span>
          <DonateTrigger
            client:visible
            label={t('budget.fund')}
            variant="soft"
            amount={it.cost}
            item={it.name}
            freq="monthly"
          />
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .sec { padding: 28px 18px 8px; }
  .kicker { margin: 0 0 6px; font-size: 12.5px; font-weight: 800; color: var(--color-fr-primary); text-transform: uppercase; letter-spacing: 0.04em; }
  .h2 { margin: 0 0 6px; font-size: 23px; font-weight: 800; color: var(--color-fr-ink); }
  .sub { margin: 0 0 16px; font-size: 14px; color: var(--color-fr-ink-soft); line-height: 1.5; }
  .totals { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px; background: var(--color-fr-primary-soft); border-radius: 18px; margin-bottom: 16px; }
  .big { display: block; font-size: 22px; font-weight: 800; color: var(--color-fr-ink); }
  .cap { font-size: 12px; color: var(--color-fr-ink-soft); }
  .gap { font-size: 13px; font-weight: 700; color: var(--color-fr-primary); text-align: right; }
  .items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .item { display: flex; gap: 12px; padding: 14px; background: var(--color-fr-surface); border: 1px solid var(--color-fr-line); border-radius: 18px; }
  .item-main { flex: 1; }
  .item-name { margin: 0 0 3px; font-weight: 700; font-size: 15px; color: var(--color-fr-ink); }
  .item-note { margin: 0 0 4px; font-size: 12.5px; color: var(--color-fr-ink-soft); line-height: 1.45; }
  .item-freq { margin: 0; font-size: 11.5px; color: var(--color-fr-ink-soft); }
  .item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0; }
  .item-cost { font-weight: 800; font-size: 15px; color: var(--color-fr-ink); white-space: nowrap; }
</style>
