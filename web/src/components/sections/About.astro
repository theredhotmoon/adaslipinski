---
import type { SiteContent } from '../../lib/types'
import type { Translator } from '../../i18n/ui'

interface Props { site: SiteContent; t: Translator }
const { site, t } = Astro.props
const { child } = site
---

<section class="sec" id="about">
  <p class="kicker">{t('about.kicker')}</p>
  <h2 class="h2">{t('about.title', { name: child.name })}</h2>

  <p class="story">{t('about.story1', { name: child.name })}</p>
  <p class="story">{t('about.story2', { name: child.name, age: child.age })}</p>
  <p class="story">{t('about.story3')}</p>

  <div class="diagnosis">
    <span class="d-label">{t('about.diagnosisLabel')}</span>
    <span class="d-value">{child.diagnosis}</span>
  </div>

  {site.milestones.length > 0 && (
    <>
      <p class="block-title">{t('about.milestones')}</p>
      <ul class="timeline">
        {site.milestones.map((m) => (
          <li class="ms">
            <span class="ms-year">{m.year}</span>
            <span class="ms-text">{m.text}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .sec { padding: 28px 18px 8px; }
  .kicker { margin: 0 0 6px; font-size: 12.5px; font-weight: 800; color: var(--color-fr-primary); text-transform: uppercase; letter-spacing: 0.04em; }
  .h2 { margin: 0 0 12px; font-size: 23px; font-weight: 800; color: var(--color-fr-ink); }
  .story { margin: 0 0 12px; font-size: 14.5px; line-height: 1.6; color: var(--color-fr-ink-soft); }
  .diagnosis { margin: 16px 0; padding: 14px; background: var(--color-fr-surface); border: 1px solid var(--color-fr-line); border-radius: 16px; }
  .d-label { display: block; font-size: 11.5px; font-weight: 800; color: var(--color-fr-primary); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; }
  .d-value { font-size: 14px; color: var(--color-fr-ink); line-height: 1.5; }
  .block-title { margin: 18px 0 12px; font-weight: 800; font-size: 14px; color: var(--color-fr-ink); }
  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ms { display: flex; gap: 12px; align-items: baseline; padding: 12px 14px; background: var(--color-fr-surface-alt); border-radius: 14px; }
  .ms-year { flex-shrink: 0; font-weight: 800; font-size: 13px; color: var(--color-fr-primary); width: 44px; }
  .ms-text { font-size: 14px; color: var(--color-fr-ink); line-height: 1.45; }
</style>
