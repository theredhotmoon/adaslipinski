---
import type { SiteContent } from '../../lib/types'
import type { Translator } from '../../i18n/ui'
import { zl } from '../../i18n/config'

interface Props { site: SiteContent; t: Translator }
const { site, t } = Astro.props
const { expenses, yearSummary } = site
---

<section class="sec" id="expenses">
  <p class="kicker">{t('expenses.kicker')}</p>
  <h2 class="h2">{t('expenses.title')}</h2>
  <p class="sub">{t('expenses.subtitle')}</p>

  {yearSummary && (
    <div class="summary">
      <div><span class="s-cap">{t('expenses.received')}</span><span class="s-val">{zl(yearSummary.in)}</span></div>
      <div><span class="s-cap">{t('expenses.spent')}</span><span class="s-val">{zl(yearSummary.out)}</span></div>
      <div><span class="s-cap">{t('expenses.left')}</span><span class="s-val">{zl(yearSummary.left)}</span></div>
    </div>
  )}

  <p class="ledger-title">{t('expenses.recentPayouts')}</p>
  <ul class="ledger">
    {expenses.map((e) => (
      <li class="row">
        <div class="row-main">
          <p class="row-desc">{e.desc}</p>
          <p class="row-meta">{e.date} · {e.place}</p>
        </div>
        <div class="row-right">
          <span class="row-amount">{zl(e.amount)}</span>
          {e.invoice && e.invoiceUrl && <a class="inv" href={e.invoiceUrl}>{t('expenses.invoicePdf')}</a>}
          {e.invoice && !e.invoiceUrl && <span class="inv-badge">✓ FV</span>}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .sec { padding: 28px 18px 8px; }
  .kicker { margin: 0 0 6px; font-size: 12.5px; font-weight: 800; color: var(--color-fr-primary); text-transform: uppercase; letter-spacing: 0.04em; }
  .h2 { margin: 0 0 6px; font-size: 23px; font-weight: 800; color: var(--color-fr-ink); }
  .sub { margin: 0 0 16px; font-size: 14px; color: var(--color-fr-ink-soft); line-height: 1.5; }
  .summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 18px; }
  .summary > div { padding: 12px; background: var(--color-fr-surface-alt); border-radius: 14px; text-align: center; }
  .s-cap { display: block; font-size: 11.5px; color: var(--color-fr-ink-soft); margin-bottom: 4px; }
  .s-val { font-weight: 800; font-size: 14px; color: var(--color-fr-ink); }
  .ledger-title { margin: 0 0 10px; font-weight: 800; font-size: 14px; color: var(--color-fr-ink); }
  .ledger { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .row { display: flex; gap: 12px; padding: 12px 14px; background: var(--color-fr-surface); border: 1px solid var(--color-fr-line); border-radius: 14px; }
  .row-main { flex: 1; }
  .row-desc { margin: 0 0 3px; font-weight: 700; font-size: 14px; color: var(--color-fr-ink); }
  .row-meta { margin: 0; font-size: 12px; color: var(--color-fr-ink-soft); }
  .row-right { display: flex; flex-direction: column; align-items: flex-end; gap: 5px; flex-shrink: 0; }
  .row-amount { font-weight: 800; font-size: 14px; color: var(--color-fr-ink); white-space: nowrap; }
  .inv { font-size: 11.5px; font-weight: 700; color: var(--color-fr-primary); }
  .inv-badge { font-size: 11px; font-weight: 700; color: var(--color-fr-ink-soft); }
</style>
