---
import type { SiteContent } from '../../lib/types'
import type { Translator } from '../../i18n/ui'
import CmsImage from '../CmsImage.astro'

interface Props { site: SiteContent; t: Translator }
const { site, t } = Astro.props
---

<section class="sec" id="gallery">
  <p class="block-title">{t('about.gallery')}</p>
  <div class="grid">
    {site.gallery.map((g) => (
      <CmsImage
        class="g-img"
        src={g.url}
        alt={t('about.gallery')}
        widths={[200, 400]}
        sizes="(min-width: 460px) 220px, 45vw"
      />
    ))}
  </div>
</section>

<style>
  .sec { padding: 28px 18px 8px; }
  .block-title { margin: 0 0 12px; font-weight: 800; font-size: 14px; color: var(--color-fr-ink); }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .g-img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 14px; display: block; }
</style>
