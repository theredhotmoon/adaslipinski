---
import type { SiteContent } from '../../lib/types'
import type { Translator } from '../../i18n/ui'
import DonateTrigger from '../islands/DonateTrigger.vue'
import CmsImage from '../CmsImage.astro'

interface Props { site: SiteContent; t: Translator }
const { site, t } = Astro.props
const { child } = site
---

<section class="hero">
  <p class="kicker">{child.heroKicker}</p>
  <h1 class="title">{child.heroTitle}</h1>
  {child.heroImageUrl && (
    <CmsImage class="photo" src={child.heroImageUrl} alt={`${child.name} — ${child.diagnosis}`} loading="eager" />
  )}
  <p class="subtitle">{child.heroSubtitle}</p>

  <!-- Above-the-fold primary action → hydrate immediately. -->
  <DonateTrigger client:load label={child.ctaLabel} variant="primary" freq="monthly" />
  <p class="methods">{t('hero.paymentMethods')}</p>

  <p class="trust">🛡 {t('trust.title')}</p>
</section>

<style>
  .hero { padding: 18px 18px 26px; background: var(--color-fr-hero-bg); border-radius: 0 0 28px 28px; text-align: center; }
  .kicker { margin: 6px 0 10px; font-size: 13px; font-weight: 800; color: var(--color-fr-primary); }
  .title { margin: 0 0 14px; font-size: 28px; line-height: 1.15; font-weight: 800; letter-spacing: -0.01em; color: var(--color-fr-ink); }
  .photo { width: 100%; border-radius: 22px; margin: 4px 0 14px; aspect-ratio: 4 / 3; object-fit: cover; }
  .subtitle { margin: 0 0 18px; font-size: 15px; line-height: 1.55; color: var(--color-fr-ink-soft); }
  .methods { margin: 12px 0 0; font-size: 12px; color: var(--color-fr-ink-soft); }
  .trust { margin: 16px 0 0; font-size: 12.5px; font-weight: 600; color: var(--color-fr-ink); }
</style>
