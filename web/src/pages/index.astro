---
import { DEFAULT_LOCALE } from '../i18n/config'
// Root → default locale. Static-friendly meta-refresh + canonical so crawlers follow
// to the indexable /pl URL rather than indexing an empty root.
const target = `/${DEFAULT_LOCALE}`
const href = new URL(target, Astro.site ?? 'https://adaslipinski.pl').href
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={href} />
    <meta name="robots" content="noindex, follow" />
    <title>Adaś Lipiński</title>
  </head>
  <body>
    <a href={target}>Adaś Lipiński →</a>
  </body>
</html>
