# Base URL of the Laravel API (no trailing slash beyond /api).
# Dev default if unset: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# ── Tolgee translation sync (optional) ───────────────────────────────────────
# Project API Key (PAK) from your Tolgee project → used by the CLI
# (npm run i18n:push / i18n:pull) and the Tolgee MCP server (.mcp.json).
# Export it in your shell before syncing; never commit the real key.
# TOLGEE_API_KEY=tgpak_xxxxxxxxxxxxxxxxxxxxxxxx
